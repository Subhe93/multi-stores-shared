{
  "compilerOptions": {
    "rootDir": "./src",
    "target": "es2022",
    "lib": ["es2022"],
    "types": [],
    "module": "es2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "removeComments": false,
    "newLine": "lf",
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
